{
  "name": "couple-finance-manager",
  "private": true,
  "version": "0.1.0",
  "description": "我們的小金庫 — 雙人家庭財務管理系統（純前端、資料只存在瀏覽器 IndexedDB）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:dist": "node scripts/check-dist.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "ci": "npm run check:lockfile && npm run lint && npm test && npm run build && npm run check:dist"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.5.1",
    "dexie": "^4.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
